{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the MediaForge window may do: call MediaForge's own commands, listen for its events, and be dragged by its toolbar. Files, processes, the network and the clipboard are reached only through those commands, which validate what they are given.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-bootstrap",
    "allow-update-settings",
    "allow-choose-destination",
    "allow-open-destination",
    "allow-choose-tool-path",
    "allow-reset-tool-path",
    "allow-refresh-tools",
    "allow-acknowledge-terms",
    "allow-set-section",
    "allow-quit-app",
    "allow-inspect-links",
    "allow-resolve-link",
    "allow-cancel-resolve",
    "allow-enqueue-downloads",
    "allow-import-files",
    "allow-choose-files-to-convert",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-remove-job",
    "allow-cancel-all",
    "allow-clear-finished",
    "allow-job-log",
    "allow-reveal-path",
    "allow-open-path",
    "allow-copy-text",
    "allow-read-clipboard",
    "allow-open-third-party-notices",
    "allow-remove-history",
    "allow-clear-history",
    "allow-repeat-history",
    "allow-thumbnail",
    "allow-waveform",
    "allow-preview-source",
    "allow-licensing-summary",
    "allow-show-main-window"
  ]
}